# Copy to .env and fill in. Never commit .env.

# LLM: any OpenAI-compatible endpoint. Defaults to Groq.
SCHEDULEBOT_LLM_BASE_URL=https://api.groq.com/openai/v1
SCHEDULEBOT_LLM_MODEL=qwen/qwen3.8-27b
SCHEDULEBOT_LLM_API_KEY=

# Core
SCHEDULEBOT_DB_PATH=/opt/schedulebot/data/schedulebot.db
SCHEDULEBOT_HORIZON_DAYS=21
SCHEDULEBOT_DEVICE_TOKEN=            # shared secret for the desktop companion

# Cold Turkey (Windows only; leave blank on other platforms)
SCHEDULEBOT_COLD_TURKEY_DB=C:\ProgramData\Cold Turkey\data-app.db
SCHEDULEBOT_COLD_TURKEY_EXE=C:\Program Files\Cold Turkey\Cold Turkey Blocker.exe
